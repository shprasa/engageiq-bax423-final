# Copy to .env and fill in values. Never commit .env to git.

# GitHub — https://github.com/settings/tokens (scope: public_repo read)
GITHUB_TOKEN=

# FREE LLM suggestions (pick one — no payment required for normal demo usage)
# Google Gemini (recommended): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Groq (alternative free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI (optional paid fallback — not required)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
